<li class="jetro-list__item event<?= $this->classList ?><?= $this->class ? ' '.$this->class : '' ?>">
  <a class="jetro-list__link" href="<?= $this->href ?>"<?= $this->target ?>>
    <div class="jetro-list__media"><?php $this->insert('jetro_event_media', $this->arrData); ?></div>
    <div class="jetro-list__body">
      <h3 class="jetro-list__title"><?= $this->link ?></h3>
      <p class="jetro-list__meta"><time datetime="<?= $this->datetime ?>"><?php if ($this->day): ?><?= $this->day ?>, <?php endif; ?><?= $this->date ?></time><?php if ($this->time): ?>, <?= $this->time ?><?php endif; ?></p>
      <?php if ($this->location): ?><p class="jetro-list__meta"><?= $this->location ?><?php if ($this->address): ?>, <?= $this->address ?><?php endif; ?></p><?php endif; ?>
    </div>
  </a>
</li>

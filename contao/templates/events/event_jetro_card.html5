<?php use Contao\Date; ?>
<div class="jetro-card event<?= $this->classList ?><?= $this->class ? ' '.$this->class : '' ?>">
  <a class="jetro-card__link" href="<?= $this->href ?>"<?= $this->target ?>>
    <div class="jetro-card__media">
      <?php if ($this->addImage && $this->picture): ?>
        <?php $this->insert('picture_default', $this->picture); ?>
      <?php else: ?>
        <div class="jetro-card__sheet" aria-hidden="true">
          <span class="jetro-card__day"><?= Date::parse('d', $this->begin ?: $this->startDate) ?></span>
          <span class="jetro-card__month"><?= Date::parse('M', $this->begin ?: $this->startDate) ?></span>
        </div>
      <?php endif; ?>
    </div>
    <div class="jetro-card__body">
      <h3 class="jetro-card__title"><?= $this->link ?></h3>
      <p class="jetro-card__meta"><time datetime="<?= $this->datetime ?>"><?php if ($this->day): ?><?= $this->day ?>, <?php endif; ?><?= $this->date ?></time></p>
      <?php if ($this->time): ?><p class="jetro-card__meta"><?= $this->time ?></p><?php endif; ?>
      <?php if ($this->location): ?><p class="jetro-card__meta"><?= $this->location ?></p><?php endif; ?>
    </div>
  </a>
</div>

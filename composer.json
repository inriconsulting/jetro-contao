{
    "name": "jetro-tools/contao-bundle",
    "type": "contao-bundle",
    "description": "Jetro: Termine aus Jetro in Contao-Kalender übernehmen",
    "keywords": ["contao", "jetro", "kalender", "gemeinde"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "contao/calendar-bundle": "^5.3",
        "contao/core-bundle": "^5.3",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.13",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "JetroTools\\ContaoBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JetroTools\\ContaoBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "JetroTools\\ContaoBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
